<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- There is deliberately no catalog-URL setting. A release build reads the
         takwerx catalog and nothing else: ATAK can import preferences from a data
         package, so an editable URL here would be a way to point the market at
         someone else's list without the operator doing anything. Debug builds
         still honour takwerxmarket_url; see TakwerxMarket.baseUrl(). -->

    <com.atakmap.android.gui.PanPreference
        android:key="manual"
        android:title="Plugin Documentation"
        android:summary="Open the TAKWERX Market user guide" />

</PreferenceScreen>
